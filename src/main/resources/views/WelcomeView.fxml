<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="900.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="at.elisabeth_tulla.walk_it_off.jfx_gui.WelcomeController">
   <center>
      <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER" spacing="8.0">
               <children>
                  <TextField fx:id="txtEmail" promptText="email" />
                  <PasswordField fx:id="txtPassword" promptText="password" />
                  <Button mnemonicParsing="false" onAction="#loginButtonClicked" text="Login" />
               </children>
               <padding>
                  <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
               </padding>
            </HBox>
            <Text fx:id="txtMessage" fill="RED" strokeType="OUTSIDE" strokeWidth="0.0" text=" ">
               <VBox.margin>
                  <Insets bottom="10.0" top="10.0" />
               </VBox.margin>
            </Text>
            <HBox alignment="CENTER" layoutX="10.0" layoutY="10.0" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Hyperlink alignment="TOP_LEFT" onAction="#registerHyperlinkClicked" text="register new user" textAlignment="CENTER" underline="true">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Hyperlink>
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
   <top>
      <TextArea prefHeight="172.0" prefWidth="600.0" text="Welcome to Walk it off!" wrapText="true" BorderPane.alignment="CENTER">
         <font>
            <Font size="29.0" />
         </font>
         <padding>
            <Insets left="10.0" top="20.0" />
         </padding>
      </TextArea>
   </top>
</BorderPane>
